# DevPilot AI - Environment Configuration Template
# Copy this file to .env and provide your secrets if desired.

# Application Configuration
PROJECT_NAME="DevPilot AI"
ENVIRONMENT=development
DEBUG=True

# Database Configuration (SQLite default for local dev)
DATABASE_URL=sqlite+aiosqlite:///./devpilot.db

# Groq Cloud LLM Provider (Optional: if omitted, mock LLM provider is utilized)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.1
LLM_MAX_RETRIES=2
